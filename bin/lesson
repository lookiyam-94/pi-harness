#!/usr/bin/env bash
# lesson - write lesson material into the Obsidian vault as it happens.
#
# Each topic is a folder under LESSON_DIR, with a main note that links to one
# note per session. Obsidian renders LaTeX and mermaid, so one copy is enough.
#
#   Learn/Networking/
#   ├── Networking.md               main note, links every session
#   ├── Networking - map.md         diagrams kept by `lesson diagram`
#   ├── Networking 2026-10-03.md
#   └── Networking 2026-10-10.md
#
#   lesson start "Topic"     < intro     open today's session, remember it
#   lesson log               < text      append to today's session note
#   lesson diagram "Name"    < mermaid   log it, and keep it as its own note
#   lesson where                         print the current notes
#
# Env:
#   OBSIDIAN_VAULT   vault root (default: ~/Notes/obsidian-vault)
#   LESSON_DIR       folder inside the vault for lessons (default: Learn)

set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/pi-vault/env"
# shellcheck source=/dev/null
if [ -f "$CONF" ]; then . "$CONF"; fi

VAULT="${OBSIDIAN_VAULT:-$HOME/Notes/obsidian-vault}"
VAULT="${VAULT%/}"
LESSON_DIR="${LESSON_DIR:-Learn}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lesson"
CURRENT="$STATE_DIR/current"
mkdir -p "$STATE_DIR"

[ -d "$VAULT" ] || { echo "lesson: $VAULT is not a directory (set OBSIDIAN_VAULT)" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
usage:
  lesson start "Topic"    < intro     open today's session note
  lesson log              < text      append to it
  lesson diagram "Name"   < mermaid   log it and keep it as its own note
  lesson where                        print current notes
EOF
  exit 1
}

# Obsidian note titles can't contain these characters.
safe_title() {
  printf '%s' "$1" | sed -e 's/[][\\/:*?"<>|#^]\+/-/g' -e 's/^[ .-]*//' -e 's/[ .-]*$//'
}

load_current() {
  [ -f "$CURRENT" ] || {
    echo "lesson: no lesson started (run 'lesson start')" >&2
    exit 1
  }
  FILE="" MAIN="" TITLE=""
  { read -r FILE; read -r MAIN; read -r TITLE; } <"$CURRENT" || true
  case "$FILE" in "$VAULT"/*) ;; *)
    echo "lesson: current lesson is from the old setup (run 'lesson start' again)" >&2
    exit 1 ;;
  esac
}

cmd_start() {
  [ $# -ge 1 ] || usage
  local title name dir main session file body
  title="$1"
  name="$(safe_title "$title")"
  body="$(cat)"
  dir="$VAULT/$LESSON_DIR/$name"
  main="$dir/$name.md"
  session="$name $(date +%F)"
  file="$dir/$session.md"
  mkdir -p "$dir"

  if [ ! -e "$main" ]; then
    printf -- '---\ntags: [lesson]\n---\n# %s\n\n## Diagrams\n\n## Sessions\n\n' "$title" >"$main"
  fi
  grep -qF "[[$session]]" "$main" || printf -- '- [[%s]]\n' "$session" >>"$main"

  # A second start on the same day continues that day's session note.
  if [ ! -e "$file" ]; then
    printf -- '---\ntags: [lesson-session]\ntopic: "[[%s]]"\ndate: %s\n---\n# %s - %s\n\n' \
      "$name" "$(date +%F)" "$title" "$(date +%F)" >"$file"
  fi
  printf '%s\n\n' "$body" >>"$file"

  printf '%s\n%s\n%s\n' "$file" "$main" "$title" >"$CURRENT"
  printf 'main=%s\nnote=%s\n' "${main#"$VAULT"/}" "${file#"$VAULT"/}"
}

cmd_log() {
  load_current
  printf '%s\n\n' "$(cat)" >>"$FILE"
}

cmd_diagram() {
  [ $# -ge 1 ] || usage
  load_current
  local name source dir note
  name="$(safe_title "$(basename "$MAIN" .md) - $1")"
  source="$(cat)"
  printf '```mermaid\n%s\n```\n\n' "$source" >>"$FILE"

  dir="$(dirname "$MAIN")"
  note="$dir/$name.md"
  printf '# %s\n\n```mermaid\n%s\n```\n' "$name" "$source" >"$note"
  if ! grep -qF "[[$name]]" "$MAIN"; then
    if grep -qx '## Diagrams' "$MAIN"; then
      sed -i "/^## Diagrams\$/a\\\n![[$name]]" "$MAIN"
    else
      printf -- '\n![[%s]]\n' "$name" >>"$MAIN"
    fi
  fi
  echo "diagram=${note#"$VAULT"/}"
}

cmd_where() {
  load_current
  printf 'main=%s\nnote=%s\n' "${MAIN#"$VAULT"/}" "${FILE#"$VAULT"/}"
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  log) shift; cmd_log ;;
  diagram) shift; cmd_diagram "$@" ;;
  where) shift; cmd_where ;;
  *) usage ;;
esac
