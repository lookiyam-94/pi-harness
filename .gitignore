# Allowlist: ignore everything, then opt in to what is safe to share.
# Never share: auth.json (API keys), sessions/, trust.json, models-store.json
/*
!/.gitignore
!/README.md
!/settings.json
!/mcp.json
!/bin/
!/agents/
!/extensions/
!/learn/
!/learning-bot/
!/.github/
!/.github/workflows/

node_modules/
**/data/
*.sqlite
*.sqlite-*
.env*
*.key
*.pem
