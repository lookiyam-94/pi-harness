{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "/usr/bin/chromium",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "duckduckgo": {
      "command": "uvx",
      "args": [
        "--from",
        "duckduckgo-mcp-server[browser]",
        "duckduckgo-mcp-server"
      ]
    }
  }
}
